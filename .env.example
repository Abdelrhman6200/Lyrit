# ── Core ──
DATABASE_URL="postgresql://lyrit:lyrit@localhost:5432/lyrit?schema=public"
APP_URL="http://localhost:3000"
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to sign webhook payloads in mock mode
# and as a pepper for token hashing.
AUTH_SECRET="change-me"

# ── Store ──
STORE_CURRENCY="EGP"

# ── Payments ──
# "mock" for development; replace with the approved Egyptian gateway adapter (e.g. "paymob").
PAYMENT_PROVIDER="mock"
# The mock provider is refused when NODE_ENV=production unless this is "true" (staging demos only).
ALLOW_MOCK_PAYMENTS="false"
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# ── Email ──
# "console" logs emails to stdout; "smtp" posts via SMTP_* settings (adapter to be added for chosen provider).
EMAIL_TRANSPORT="console"
EMAIL_FROM="LYRIT <hello@lyrit.example>"

# ── Media ──
# "local" stores uploads on disk (UPLOAD_DIR), served from /media/*. Use an S3-compatible adapter at scale.
MEDIA_STORAGE="local"
UPLOAD_DIR="./storage/uploads"
MEDIA_PUBLIC_HOST=""

# ── Seed ──
SEED_ADMIN_EMAIL="admin@lyrit.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
CRON_SECRET="change-me-cron-secret"
# "production" enables indexing in robots.txt; anything else blocks crawlers (staging).
APP_ENV="development"
