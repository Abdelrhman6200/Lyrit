// LYRIT e-commerce data model.
// Conventions: UUID primary keys, snake_case tables/columns, money stored as
// integer minor units (piasters for EGP) — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  CUSTOMER
  FULFILLMENT
  STORE_MANAGER
  SUPER_ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  roles     UserRole[]
  sessions  Session[]
  tokens    AuthToken[]
  addresses CustomerAddress[]
  orders    Order[]
  carts     Cart[]
  auditLogs AuditLog[]
  notes     CustomerNote[]    @relation("CustomerNotes")

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  tokenHash String        @unique @map("token_hash")
  type      AuthTokenType
  userId    String        @map("user_id") @db.Uuid
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model CustomerAddress {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name")
  phone         String
  governorate   String
  city          String
  street        String
  building      String?
  apartment     String?
  instructions  String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_addresses")
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  customer   User     @relation("CustomerNotes", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_notes")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  description    String?
  thumbnailUrl   String?  @map("thumbnail_url")
  bannerUrl      String?  @map("banner_url")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  isVisible      Boolean  @default(true) @map("is_visible")
  sortOrder      Int      @default(0) @map("sort_order")
  parentId       String?  @map("parent_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([isVisible, sortOrder])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  slug              String        @unique
  shortDescription  String?       @map("short_description")
  description       String?
  benefits          String[]      @default([])
  ingredients       String?
  usageInstructions String?       @map("usage_instructions")
  precautions       String?
  tags              String[]      @default([])
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false) @map("is_featured")
  featuredOrder     Int           @default(0) @map("featured_order")
  seoTitle          String?       @map("seo_title")
  seoDescription    String?       @map("seo_description")
  publishedAt       DateTime?     @map("published_at")
  // Maintained by a database trigger (see migration "search"). Used for full-text search.
  searchVector      Unsupported("tsvector")? @map("search_vector")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  variants   ProductVariant[]
  images     ProductImage[]
  categories ProductCategory[]
  related    RelatedProduct[]  @relation("RelatedFrom")
  relatedTo  RelatedProduct[]  @relation("RelatedTo")

  @@index([status, isFeatured])
  @@index([status, createdAt])
  @@index([searchVector], type: Gin)
  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  sku                 String   @unique
  variantName         String   @map("variant_name")
  attributes          Json     @default("{}")
  priceMinor          Int      @map("price_minor")
  compareAtPriceMinor Int?     @map("compare_at_price_minor")
  currency            String   @default("EGP") @db.Char(3)
  stockQuantity       Int      @default(0) @map("stock_quantity")
  lowStockThreshold   Int      @default(5) @map("low_stock_threshold")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String   @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model RelatedProduct {
  productId String  @map("product_id") @db.Uuid
  relatedId String  @map("related_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related   Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId])
  @@map("related_products")
}

enum InventoryReason {
  INITIAL
  RESTOCK
  ADJUSTMENT
  DAMAGED
  ORDER_PLACED
  ORDER_CANCELED
  RETURN
}

model InventoryMovement {
  id        String          @id @default(uuid()) @db.Uuid
  variantId String          @map("variant_id") @db.Uuid
  delta     Int
  balance   Int
  reason    InventoryReason
  note      String?
  orderId   String?         @map("order_id") @db.Uuid
  actorId   String?         @map("actor_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

// ───────────────────────────── Cart ─────────────────────────────

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  discountCode String?    @map("discount_code")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ───────────────────────────── Orders ─────────────────────────────

enum OrderStatus {
  PENDING // created, awaiting payment confirmation (online payments)
  CONFIRMED // accepted for fulfilment (paid, or COD accepted)
  CANCELED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum PaymentMethod {
  COD
  CARD
  WALLET
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  orderNumber       String            @unique @map("order_number")
  publicToken       String            @unique @map("public_token")
  customerId        String?           @map("customer_id") @db.Uuid
  customerName      String            @map("customer_name")
  customerEmail     String            @map("customer_email")
  customerPhone     String            @map("customer_phone")
  currency          String            @default("EGP") @db.Char(3)
  subtotalMinor     Int               @map("subtotal_minor")
  discountMinor     Int               @default(0) @map("discount_minor")
  shippingMinor     Int               @default(0) @map("shipping_minor")
  totalMinor        Int               @map("total_minor")
  discountCode      String?           @map("discount_code")
  paymentMethod     PaymentMethod     @map("payment_method")
  paymentStatus     PaymentStatus     @default(UNPAID) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  orderStatus       OrderStatus       @default(PENDING) @map("order_status")
  shippingMethod    String?           @map("shipping_method")
  internalNotes     String?           @map("internal_notes")
  placedAt          DateTime?         @map("placed_at")
  canceledAt        DateTime?         @map("canceled_at")
  stockRestoredAt   DateTime?         @map("stock_restored_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  customer    User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  address     OrderAddress?
  payments    Payment[]
  shipments   Shipment[]
  redemptions DiscountRedemption[]
  events      OrderEvent[]

  @@index([customerId])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  variantId      String?         @map("variant_id") @db.Uuid
  productName    String          @map("product_name")
  variantName    String          @map("variant_name")
  sku            String
  imageUrl       String?         @map("image_url")
  unitPriceMinor Int             @map("unit_price_minor")
  quantity       Int
  lineTotalMinor Int             @map("line_total_minor")
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderAddress {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @unique @map("order_id") @db.Uuid
  recipientName String  @map("recipient_name")
  phone         String
  governorate   String
  city          String
  street        String
  building      String?
  apartment     String?
  instructions  String?
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  type      String
  message   String
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  provider          String
  providerReference String?              @unique @map("provider_reference")
  idempotencyKey    String               @unique @map("idempotency_key")
  method            PaymentMethod
  amountMinor       Int                  @map("amount_minor")
  currency          String               @db.Char(3)
  status            PaymentAttemptStatus @default(INITIATED)
  failureReason     String?              @map("failure_reason")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model Shipment {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  carrier           String?
  trackingReference String?   @map("tracking_reference")
  trackingUrl       String?   @map("tracking_url")
  shippedAt         DateTime? @map("shipped_at")
  deliveredAt       DateTime? @map("delivered_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}

// ───────────────────────────── Shipping ─────────────────────────────

model ShippingZone {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  regions               String[] // governorates covered by this zone
  feeMinor              Int      @map("fee_minor")
  freeShippingThreshold Int?     @map("free_shipping_threshold_minor")
  estimatedDaysMin      Int      @default(2) @map("estimated_days_min")
  estimatedDaysMax      Int      @default(5) @map("estimated_days_max")
  codAvailable          Boolean  @default(true) @map("cod_available")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("shipping_zones")
}

// ───────────────────────────── Promotions ─────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model DiscountCode {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique
  description         String?
  type                DiscountType
  value               Int // percentage points (1-100) or minor units
  minOrderMinor       Int?         @map("min_order_minor")
  maxDiscountMinor    Int?         @map("max_discount_minor")
  usageLimit          Int?         @map("usage_limit")
  perCustomerLimit    Int?         @map("per_customer_limit")
  usageCount          Int          @default(0) @map("usage_count")
  startsAt            DateTime?    @map("starts_at")
  expiresAt           DateTime?    @map("expires_at")
  isActive            Boolean      @default(true) @map("is_active")
  eligibleCategoryIds String[]     @default([]) @map("eligible_category_ids")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  redemptions DiscountRedemption[]

  @@map("discount_codes")
}

model DiscountRedemption {
  id             String       @id @default(uuid()) @db.Uuid
  discountCodeId String       @map("discount_code_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  customerEmail  String       @map("customer_email")
  amountMinor    Int          @map("amount_minor")
  createdAt      DateTime     @default(now()) @map("created_at")
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, orderId])
  @@index([customerEmail])
  @@map("discount_redemptions")
}

// ───────────────────────────── Content ─────────────────────────────

model ContentBlock {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // e.g. "hero", "announcement", "promo-1", "benefits"
  type      String
  data      Json
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("content_blocks")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Page {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  title          String
  body           String
  seoDescription String?  @map("seo_description")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("pages")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  consentAt      DateTime  @map("consent_at")
  source         String?
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String?
  message   String
  handledAt DateTime? @map("handled_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("contact_messages")
}

// ───────────────────────────── Operations ─────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NotificationLog {
  id        String   @id @default(uuid()) @db.Uuid
  dedupeKey String   @unique @map("dedupe_key") // e.g. "order:<id>:confirmation"
  channel   String   @default("email")
  recipient String
  template  String
  status    String // SENT | FAILED
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notification_logs")
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@map("rate_limit_buckets")
}
